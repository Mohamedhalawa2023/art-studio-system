{
  "name": "marsam",
  "version": "0.1.0",
  "private": true,
  "description": "نظام سطح مكتب لإدارة المرسم والكورسات والحضور والمدفوعات والمخزون",
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/build-next.js",
    "start": "node .next/standalone/server.js",
    "lint": "eslint",
    "test": "node --test scripts/enrollment.service.test.cjs",
    "desktop": "concurrently -k -s first \"next dev --hostname 127.0.0.1\" \"wait-on http://127.0.0.1:3000 && electron .\"",
    "app:desktop": "electron .",
    "electron:only": "electron .",
    "prebuild:exe": "node scripts/generate-app-icon.cjs",
    "build:exe": "npm run build && electron-builder"
  },
  "dependencies": {
    "@types/qrcode": "^1.5.6",
    "lucide-react": "^1.55.0",
    "next": "16.4.3",
    "qrcode": "^1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^10.0.6",
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wait-on": "^9.5.1"
  },
  "main": "electron/main.js",
  "build": {
    "appId": "com.marsam.desktop",
    "productName": "مرسم - إدارة المرسم",
    "npmRebuild": false,
    "nodeGypRebuild": false,
    "afterPack": "./electron/afterPack.js",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "public/icon.ico"
    },
    "portable": {
      "artifactName": "Marsam-Portable.exe"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "مرسم للفنون",
      "artifactName": "Marsam-Setup.exe"
    },
    "files": [
      "electron/**/*",
      "package.json",
      "!node_modules/**"
    ],
    "extraResources": [
      {
        "from": "public",
        "to": "public"
      }
    ]
  }
}
