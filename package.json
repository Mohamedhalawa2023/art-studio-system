{
  "name": "marsam",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/copy-standalone.js",
    "start": "next start",
    "lint": "eslint",
    "desktop": "concurrently -k -s first \"next dev\" \"wait-on http://localhost:3000 && electron .\"",
    "app:desktop": "electron .",
    "electron:only": "electron .",
    "build:exe": "next build && electron-builder"
  },
  "dependencies": {
    "@types/qrcode": "^1.5.6",
    "lucide-react": "^1.55.0",
    "next": "16.4.0",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^10.0.6",
    "electron": "^44.7.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wait-on": "^9.5.1"
  },
  "main": "electron/main.js",
  "build": {
    "appId": "com.marsam.desktop",
    "productName": "مرسم - إدارة المرسم",
    "npmRebuild": false,
    "nodeGypRebuild": false,
    "afterPack": "./electron/afterPack.js",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": ["nsis", "portable"],
      "icon": "public/icon.ico"
    },
    "portable": {
      "artifactName": "Marsam-Portable.exe"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "مرسم للفنون",
      "artifactName": "Marsam-Setup.exe"
    },
    "files": [
      "electron/**/*",
      "package.json",
      "!node_modules/**"
    ],
    "extraResources": [
      {
        "from": "public",
        "to": "public"
      }
    ]
  }
}